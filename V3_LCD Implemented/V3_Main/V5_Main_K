  return html;
}

void setup() {
  Serial.begin(115200);

  // 1. Relay setup (Active Low - pumps OFF on boot)
  pinMode(PUMP_A, OUTPUT);
  pinMode(PUMP_B, OUTPUT);
  digitalWrite(PUMP_A, PUMP_OFF);
  digitalWrite(PUMP_B, PUMP_OFF);

  // 2. LCD setup
  Wire.begin(21, 22);
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print(padTo("SFU Smart Irrigation", 20));
  lcd.setCursor(0, 1);
  lcd.print(padTo("Initializing...", 20));
  lcd.setCursor(0, 2);
  lcd.print(padTo("Waiting for nodes", 20));
  lcd.setCursor(0, 3);
  lcd.print(padTo("AP: ESP32-Hub", 20));

  // 3. WiFi + ESP-NOW
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(ssid, password);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW Init Failed");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("ESP-NOW INIT FAIL");
    return;
  }

  esp_now_register_recv_cb(esp_now_recv_cb_t(OnDataRecv));

  // 4. Web server
  server.on("/", []() {
    server.send(200, "text/html", getHTML());
  });
  server.begin();
  Serial.println("System Initialized.");
}

void loop() {
  server.handleClient();
  controlPumps();

  // --- LCD UPDATE: Every 2 seconds, never in callback ---
  static unsigned long lastLCD = 0;
  if (millis() - lastLCD > 2000) {
    lastLCD = millis();
    heartBeat = !heartBeat;

    // Row 0: Bed A status
    String rowA = "A:" + String((int)avgA) + "% " + (isPumpAActive ? "PUMP:ON " : "PUMP:OFF");
    lcd.setCursor(0, 0);
    lcd.print(padTo(rowA, 19));
    lcd.setCursor(19, 0);
    lcd.print(heartBeat ? "*" : " ");

    // Row 1: Bed B status
    String rowB = "B:" + String((int)avgB) + "% " + (isPumpBActive ? "PUMP:ON " : "PUMP:OFF");
    lcd.setCursor(0, 1);
    lcd.print(padTo(rowB, 20));

    // Row 2: Node 1 & 2 raw values
    String row2 = "N1:" + String(boardsStruct[0].soilmoisture) +
                  "% N2:" + String(boardsStruct[1].soilmoisture) + "%";
    lcd.setCursor(0, 2);
    lcd.print(padTo(row2, 20));

    // Row 3: Node 3 & 4 raw values
    String row3 = "N3:" + String(boardsStruct[2].soilmoisture) +
                  "% N4:" + String(boardsStruct[3].soilmoisture) + "%";
    lcd.setCursor(0, 3);
    lcd.print(padTo(row3, 20));
  }
}
