  html += String(isPumpAActive ? "&#128167; WATERING" : "IDLE") + "</td></tr>";

  // Row B
  html += "<tr><td><b>Bed B (3&amp;4)</b></td>";
  html += "<td>" + String(boardsStruct[2].soilmoisture) + "%</td>";
  html += "<td>" + String(boardsStruct[3].soilmoisture) + "%</td>";
  html += "<td><b>" + String(avgB, 1) + "%</b></td>";
