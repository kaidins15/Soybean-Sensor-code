  html += "<h1>&#127807; SFU Capstone: Smart Irrigation Hub</h1>";
  html += "<p class='water-total'>Cumulative Usage &mdash; Bed A: <b>" + String(totalWaterA, 3) + "L</b> | Bed B: <b>" + String(totalWaterB, 3) + "L</b></p>";
  html += "<table>";
  html += "<tr><th>Test Bed</th><th>Sensor 1</th><th>Sensor 2</th><th>Average</th><th>Pump Status</th></tr>";

  // Row A
  html += "<tr><td><b>Bed A (1&amp;2)</b></td>";
  html += "<td>" + String(boardsStruct[0].soilmoisture) + "%</td>";
