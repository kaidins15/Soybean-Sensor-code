  h += "<div class='testbed-card'>";
  h += "<div class='testbed-title'>▸ TESTBED A</div>";
  h += "<div class='moisture-label'>Avg Moisture</div>";
  h += "<div class='moisture-value'>" + String(currentPcA, 1) + "<span style='font-size:1.2rem'>%</span></div>";
  h += "<div class='bar-track'><div class='bar-fill' style='width:" + String(min(currentPcA, 100.0f), 1) + "%'></div></div>";
  h += "<div class='sensor-grid'>";
