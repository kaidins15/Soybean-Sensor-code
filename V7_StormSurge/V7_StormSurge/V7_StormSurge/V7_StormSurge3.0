  h += "<div class='sensor-box'><div class='sensor-name'>Sensor 2</div><div class='sensor-val'>" + String(sensors[1].soilmoisture) + "%</div><div class='sensor-sub'>ADC: " + String(sensors[1].moistureRaw) + "</div></div>";
  h += "</div>";
  h += "<div class='delta-row'><span class='delta-label'>Δ ADC Since Baseline</span><span class='delta-val'>" + String(deltaAdcA, 1) + "</span></div>";
  h += "<div class='pump-row'><span class='pump-label'>Pump A Status</span><span class='pump-badge " + pumpAClass + "'>" + pumpAState + "</span></div>";
  h += "</div>";

  // Testbed B
  String pumpBState = digitalRead(PUMP_B) == PUMP_ON ? "ON" : "OFF";
  String pumpBClass = pumpBState == "ON" ? "pump-on" : "pump-off";
  h += "<div class='testbed-card'>";
  h += "<div class='testbed-title'>▸ TESTBED B</div>";
  h += "<div class='moisture-label'>Avg Moisture</div>";
